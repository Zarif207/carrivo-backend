generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────
enum Role {
  CUSTOMER
  COURIER
  ADMIN
  ADMIN_VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ShipmentStatus {
  PENDING
  PICKUP_SCHEDULED
  COURIER_ASSIGNED
  PICKED_UP
  AT_ORIGIN_HUB
  IN_TRANSIT
  AT_DESTINATION_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

enum ShipmentPaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUND_PENDING 
  REFUNDED
}

enum ServiceType {
  STANDARD
  EXPRESS
  SAME_DAY
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
  TRUCK
}

enum PickupStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EarningStatus {
  PENDING
  PAID
}

enum NotificationType {
  SHIPMENT_CREATED
  COURIER_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  PAYMENT_RECEIVED
  REFUND_COMPLETED
  // Staff-only (ADMIN + ADMIN_VIEWER feed, see notification.staff.ts)
  SHIPMENT_CANCELLED
  PAYMENT_FAILED
  REFUND_FAILED
  ZONE_CHANGED
  HUB_CHANGED
  COURIER_ADDED
  // Courier applications: staff hear about new ones, the applicant about the decision.
  COURIER_APPLICATION_SUBMITTED
  COURIER_APPLICATION_APPROVED
  COURIER_APPLICATION_REJECTED
}

enum CourierApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED // withdrawn by the applicant while PENDING
}

/// When an applicant can work (courier applications).
enum WorkAvailability {
  WEEKDAYS
  WEEKENDS
  FULL_TIME
}

enum EmailStatus {
  PENDING // row committed, email not attempted yet
  SENT
  FAILED
  SKIPPED // RESEND_API_KEY not configured
}

// ───────────── Better Auth core (user/session/account/verification) ─────────────
model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          Role       @default(CUSTOMER) // Better Auth additionalField, input:false (Phase 2)
  phone         String?
  address       String?
  status        UserStatus @default(ACTIVE)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions                    Session[]
  accounts                    Account[]
  courierProfile              CourierProfile?
  shipments                   Shipment[]              @relation("CustomerShipments")
  assignedShipments           Shipment[]              @relation("CourierShipments")
  statusChanges               ShipmentStatusHistory[]
  pickupRequests              PickupRequest[]
  payments                    Payment[]
  earnings                    CourierEarning[]
  auditLogs                   AuditLog[]
  notifications               Notification[]
  courierApplications         CourierApplication[]    @relation("CourierApplicant")
  reviewedCourierApplications CourierApplication[]    @relation("CourierApplicationReviewer")

  @@index([role, status]) // admin user list, last-admin lock, dashboard counts
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ───────────── Geography ─────────────
model Zone {
  id          String    @id @default(uuid(7))
  name        String
  code        String    @unique // e.g. "DHK-N"
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hubs                 Hub[]
  couriers             CourierProfile[]
  originShipments      Shipment[]           @relation("OriginZone")
  destinationShipments Shipment[]           @relation("DestinationZone")
  originPricingRules   PricingRule[]        @relation("PricingOrigin")
  destPricingRules     PricingRule[]        @relation("PricingDestination")
  courierApplications  CourierApplication[]

  @@index([isActive, deletedAt])
  @@map("zones")
}

model Hub {
  id        String    @id @default(uuid(7))
  name      String
  code      String    @unique
  address   String
  city      String
  phone     String?
  zoneId    String
  zone      Zone      @relation(fields: [zoneId], references: [id])
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  couriers             CourierProfile[]
  originShipments      Shipment[]              @relation("OriginHub")
  destinationShipments Shipment[]              @relation("DestinationHub")
  currentShipments     Shipment[]              @relation("CurrentHub")
  statusEvents         ShipmentStatusHistory[]

  @@index([zoneId])
  @@index([deletedAt])
  @@map("hubs")
}

// ───────────── Pricing ─────────────
// Weights in pounds, money in USD: price = baseFee + ceil(max(0, weightLb - baseWeightLb)) * perLbFee
// Rule lookup (Phase 3): exact (service, origin, dest) → (service, null, null) fallback.
model PricingRule {
  id                String      @id @default(uuid(7))
  name              String
  serviceType       ServiceType
  originZoneId      String?
  originZone        Zone?       @relation("PricingOrigin", fields: [originZoneId], references: [id])
  destinationZoneId String?
  destinationZone   Zone?       @relation("PricingDestination", fields: [destinationZoneId], references: [id])
  baseFee           Decimal     @db.Decimal(10, 2)
  baseWeightLb      Decimal     @default(1) @db.Decimal(8, 2)
  perLbFee          Decimal     @db.Decimal(10, 2)
  maxWeightLb       Decimal?    @db.Decimal(8, 2)
  isActive          Boolean     @default(true)
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([serviceType, originZoneId, destinationZoneId])
  @@index([isActive, deletedAt])
  @@map("pricing_rules")
}

// ───────────── Courier ─────────────
model CourierProfile {
  id            String      @id @default(uuid(7))
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  vehicleType   VehicleType
  vehicleNumber String?
  licenseNumber String?
  zoneId        String // operating zone, checked on assignment
  zone          Zone        @relation(fields: [zoneId], references: [id])
  hubId         String?
  hub           Hub?        @relation(fields: [hubId], references: [id])
  isAvailable   Boolean     @default(true)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([zoneId, isAvailable])
  @@index([hubId])
  @@index([deletedAt])
  @@map("courier_profiles")
}

/// A CUSTOMER asking to become a COURIER; an ADMIN approves (user becomes COURIER with a
/// CourierProfile) or rejects (reviewNote required). No driver licence, SSN or other government ID
/// is collected. The migration SQL adds what Prisma can't express:
/// - partial unique index courier_applications_one_pending_per_user: at most ONE PENDING per user,
/// - CHECK constraints: a decision has reviewer + time, a rejection has a note, text length caps.
/// Prisma doesn't model either, and leaves both alone (`migrate diff` against a migrated DB is empty).
model CourierApplication {
  id              String                   @id @default(uuid(7))
  userId          String
  user            User                     @relation("CourierApplicant", fields: [userId], references: [id])
  status          CourierApplicationStatus @default(PENDING)
  phone           String // US format (phoneSchema)
  preferredZoneId String?
  preferredZone   Zone?                    @relation(fields: [preferredZoneId], references: [id])
  vehicleType     VehicleType
  vehiclePlate    String?
  availability    WorkAvailability
  experience      String? // max 500
  about           String? // max 1000
  reviewedById    String?
  reviewedBy      User?                    @relation("CourierApplicationReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNote      String? // required on REJECTED, max 500
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, createdAt]) // admin queue: ?status=PENDING, newest first
  @@index([userId]) // "my application" + history
  @@index([preferredZoneId]) // admin zone filter
  @@map("courier_applications")
}

// ───────────── Shipment ─────────────
model Shipment {
  id         String @id @default(uuid(7))
  trackingId String @unique

  customerId String
  customer   User    @relation("CustomerShipments", fields: [customerId], references: [id])
  courierId  String? // User.id of a COURIER
  courier    User?   @relation("CourierShipments", fields: [courierId], references: [id])

  senderName      String
  senderPhone     String
  pickupAddress   String
  receiverName    String
  receiverPhone   String
  receiverEmail   String?
  deliveryAddress String

  originZoneId      String
  originZone        Zone    @relation("OriginZone", fields: [originZoneId], references: [id])
  destinationZoneId String
  destinationZone   Zone    @relation("DestinationZone", fields: [destinationZoneId], references: [id])
  originHubId       String?
  originHub         Hub?    @relation("OriginHub", fields: [originHubId], references: [id])
  destinationHubId  String?
  destinationHub    Hub?    @relation("DestinationHub", fields: [destinationHubId], references: [id])
  currentHubId      String?
  currentHub        Hub?    @relation("CurrentHub", fields: [currentHubId], references: [id])

  weightLb      Decimal     @db.Decimal(8, 2)
  description   String?
  declaredValue Decimal?    @db.Decimal(10, 2)
  isFragile     Boolean     @default(false)
  serviceType   ServiceType

  price          Decimal @db.Decimal(10, 2) // server-calculated
  priceBreakdown Json // snapshot of rule + components
  currency       String  @default("usd") // platform currency (PLATFORM_CURRENCY in code)

  status                    ShipmentStatus        @default(PENDING)
  paymentStatus             ShipmentPaymentStatus @default(UNPAID)
  failedAttempts            Int                   @default(0)
  failureReason             String?
  cancelReason              String?
  proofOfDeliveryUrl        String?
  proofOfDeliveryPublicId   String? 
  proofOfDeliveryUploadedAt DateTime?

  estimatedDeliveryAt DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  statusHistory ShipmentStatusHistory[]
  pickupRequest PickupRequest?
  payments      Payment[]
  earning       CourierEarning?
  notifications Notification[]

  @@index([status])
  @@index([paymentStatus])
  @@index([customerId, createdAt])
  @@index([courierId, status])
  @@index([originZoneId])
  @@index([destinationZoneId])
  @@index([serviceType])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([originHubId])
  @@index([destinationHubId])
  @@index([currentHubId])
  @@index([trackingId(ops: raw("gin_trgm_ops"))], type: Gin, map: "shipments_trackingId_trgm_idx")
  @@index([receiverName(ops: raw("gin_trgm_ops"))], type: Gin, map: "shipments_receiverName_trgm_idx")
  @@index([receiverPhone(ops: raw("gin_trgm_ops"))], type: Gin, map: "shipments_receiverPhone_trgm_idx")
  @@map("shipments")
}

model ShipmentStatusHistory {
  id          String          @id @default(uuid(7))
  shipmentId  String
  shipment    Shipment        @relation(fields: [shipmentId], references: [id])
  fromStatus  ShipmentStatus? 
  toStatus    ShipmentStatus
  note        String?
  hubId       String?
  hub         Hub?            @relation(fields: [hubId], references: [id])
  changedById String? 
  changedBy   User?           @relation(fields: [changedById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([shipmentId, createdAt])
  @@map("shipment_status_history")
}

model PickupRequest {
  id             String       @id @default(uuid(7))
  shipmentId     String       @unique // one pickup per shipment; reschedule = update
  shipment       Shipment     @relation(fields: [shipmentId], references: [id])
  requestedById  String
  requestedBy    User         @relation(fields: [requestedById], references: [id])
  pickupAddress  String
  contactName    String
  contactPhone   String
  scheduledAt    DateTime 
  scheduledUntil DateTime 
  notes          String?
  status         PickupStatus @default(SCHEDULED)
  completedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, scheduledAt])
  @@index([deletedAt])
  @@map("pickup_requests")
}

// ───────────── Payments ─────────────
model Payment {
  id                    String        @id @default(uuid(7))
  shipmentId            String
  shipment              Shipment      @relation(fields: [shipmentId], references: [id])
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  amount                Decimal       @db.Decimal(10, 2) // what we ask Stripe to charge (= shipment price)
  currency              String        @default("usd") // platform currency (PLATFORM_CURRENCY in code)
  status                PaymentStatus @default(PENDING)
  provider              String        @default("STRIPE") // STRIPE | SEED | DEV
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  stripeRefundId        String?       @unique
  checkoutUrl           String? // returned again while the session is open
  expiresAt             DateTime? // Checkout Session expiry
  paidAmount            Decimal?      @db.Decimal(10, 2) // what Stripe reports as paid
  paidCurrency          String?
  paidAt                DateTime?
  refundedAt            DateTime?
  failureReason         String? // last failure / card decline message
  requiresReview        Boolean       @default(false) // amount mismatch, duplicate payment, refund failure
  reviewReason          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([shipmentId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([requiresReview])
  @@map("payments")
}

/// Webhook idempotency: one row per processed Stripe event id.
model StripeEvent {
  id          String   @id // evt_...
  type        String
  paymentId   String?
  processedAt DateTime @default(now())

  @@index([paymentId])
  @@map("stripe_events")
}

model CourierEarning {
  id         String        @id @default(uuid(7))
  courierId  String 
  courier    User          @relation(fields: [courierId], references: [id])
  shipmentId String        @unique // one earning per delivered shipment
  shipment   Shipment      @relation(fields: [shipmentId], references: [id])
  amount     Decimal       @db.Decimal(10, 2)
  status     EarningStatus @default(PENDING)
  paidOutAt  DateTime?
  createdAt  DateTime      @default(now())

  @@index([courierId, createdAt])
  @@index([status])
  @@map("courier_earnings")
}

// ───────────── Audit ─────────────
model AuditLog {
  id         String   @id @default(uuid(7))
  actorId    String? 
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  Role?
  action     String 
  entityType String 
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────── Notifications ─────────────

model Notification {
  id          String           @id @default(uuid(7))
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  shipmentId  String?
  shipment    Shipment?        @relation(fields: [shipmentId], references: [id])
  type        NotificationType
  title       String
  message     String
  link        String?
  dedupeKey   String?          @unique
  readAt      DateTime?
  emailStatus EmailStatus      @default(PENDING)
  emailError  String? 
  emailSentAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, readAt, createdAt]) 
  @@index([userId, createdAt])
  @@index([shipmentId])
  @@map("notifications")
}
