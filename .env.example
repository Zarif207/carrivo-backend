# ── App ──────────────────────────────────────────────
# Set NODE_ENV=production in Vercel (stack traces are only ever shown when it is
# "development" AND not running on Vercel).
NODE_ENV=development
PORT=5000
# Exact origins, comma-separated, no trailing slash, e.g.
# CORS_ORIGINS=http://localhost:3000,https://carrivo-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000
# Frontend ORIGIN (no path). Google sign-in lands on FRONTEND_URL/auth/google/callback and
# email links point to FRONTEND_URL/shipments/<id>; the paths live in
# src/app/config/frontendRoutes.ts. Production: https://<your-frontend>.vercel.app
FRONTEND_URL=http://localhost:3000

# ── Database (Neon / Supabase) ───────────────────────
# Pooled connection string, used by the app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Direct (non-pooled) connection string, used by Prisma CLI for migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── Better Auth ──────────────────────────────────────
# At least 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of THIS API (no path). Production: https://<your-api>.vercel.app
BETTER_AUTH_URL=http://localhost:5000

# ── Seed (npm run db:seed) ───────────────────────────
# Password shared by all demo accounts. Choose your own; never commit it.
# Demo accounts created by the seed:
#   ADMIN     admin@carrivo.dev
#   COURIER   courier1@carrivo.dev, courier2@carrivo.dev
#   CUSTOMER  customer1@carrivo.dev, customer2@carrivo.dev
SEED_DEMO_PASSWORD=<choose-a-demo-password>

# ── Google sign-in ───────────────────────────────────
# Required. Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorized redirect URIs (BETTER_AUTH_URL + /api/v1/auth/callback/google):
#   http://localhost:5000/api/v1/auth/callback/google
#   https://<your-api>.vercel.app/api/v1/auth/callback/google
# No JavaScript origins needed. Manual test without a frontend: README → Authentication.
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ── Stripe (payments, platform currency USD) ─────
# Required. Use TEST keys (sk_test_...) everywhere except production.
STRIPE_SECRET_KEY=sk_test_<your-test-secret-key>
# Required. Locally: the whsec_... printed by `stripe listen`. On Vercel: the signing
# secret of the Dashboard webhook endpoint (a different value).
STRIPE_WEBHOOK_SECRET=whsec_<signing-secret>
# Where Stripe Checkout sends the customer back (frontend pages).
# The API appends ?session_id={CHECKOUT_SESSION_ID} to the success URL.
FRONTEND_SUCCESS_URL=http://localhost:3000/payment/success
FRONTEND_CANCEL_URL=http://localhost:3000/payment/cancel

# ── Upstash Redis (cache + rate limits) ──────────────
# Optional. Without both values the app still works: no cache, and rate limits
# are per serverless instance. Redis errors/timeouts (500 ms) fail open.
# Create the Upstash database in the same region as the Vercel functions: the
# rate limiter makes one REST call per request.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Prefix for every key the app writes. Use a different one per environment
# that shares a Redis database (e.g. carrivo:dev: locally).
REDIS_KEY_PREFIX=carrivo:v1:

# ── Cloudinary (proof-of-delivery images) ────────────
# Required. Dashboard → API Keys. Images go to the carrivo/proof-of-delivery folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email notifications (Resend) ─────────────────────
# Optional. Without a key, notifications are still stored (GET /notifications/my)
# but no email is sent (logged once). Email failures never fail a request.
RESEND_API_KEY=
# Optional, default "Carrivo <onboarding@resend.dev>". That test sender only delivers to
# your own Resend account address; verify a domain in Resend to email anyone else.
EMAIL_FROM=

# ── DEV ONLY: scripts/dev-mark-paid.ts ───────────────
# Lets `npm run dev:mark-paid -- <trackingId>` mark a shipment PAID before Stripe
# (Phase 6) exists. Local development only.
# NEVER set this in Vercel (or any deployed environment). The script also refuses
# to run when NODE_ENV=production or on Vercel, and the app never reads it.
DEV_ALLOW_MARK_PAID=false
