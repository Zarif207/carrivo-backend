# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Frontend base URL (used for redirects: Stripe success/cancel, auth callbacks)
FRONTEND_URL=http://localhost:3000

# ── Database (Neon / Supabase) ───────────────────────
# Pooled connection string, used by the app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Direct (non-pooled) connection string, used by Prisma CLI for migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── Better Auth (Phase 2) ────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# ── Google OAuth (Phase 7) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe (Phase 6) ─────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# ── Upstash Redis (Phase 5) ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudinary (Phase 7) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Phase 7) ──────────────────────────────────
EMAIL_FROM=
